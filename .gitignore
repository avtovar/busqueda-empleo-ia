# Dependencias
node_modules/
frontend/node_modules/

# Build artifact: `npm run build` lo regenera. Nunca se versiona.
frontend/dist/
dist/
.vercel/

# Secretos. NUNCA se commitean. Copiá .env.example a .env y poné los valores ahí.
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
serviceAccountKey.json

# Carpeta LOCAL y privada: lo que va acá nunca viaja a GitHub. Es el lugar para
# los .env de trabajo, los CVs de prueba y los dumps de la base.
no_subir/

# Logs y ruido local
*.log
npm-debug.log*
.DS_Store

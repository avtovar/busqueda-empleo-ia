# Dependencias
node_modules/
frontend/node_modules/

# Build artifact: `npm run build` lo regenera. Nunca se versiona.
frontend/dist/
dist/
.vercel/

# Secretos. NUNCA se commitean. Copiá .env.example a .env y poné los valores ahí.
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
serviceAccountKey.json

# Carpeta LOCAL y privada: lo que va acá nunca viaja a GitHub. Es el lugar para
# los .env de trabajo, los CVs de prueba y los dumps de la base.
no_subir/

# Logs y ruido local
*.log
npm-debug.log*
.DS_Store

# Scripts temporales de verificación. Los que se escriben para probar algo contra la
# base o contra las bolsas llevan el `DATABASE_URL` y el `SESSION_SECRET` INLINE,
# que es justo la forma que la regla de secretos de `AGENTS.md` prohíbe. Además no
# son parte del proyecto: los que valen están en `scripts/`, versionados y sin
# secretos. Los reales se escriben en el temp del sistema, no acá.
_tmp_*

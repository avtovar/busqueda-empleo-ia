{
  "name": "busqueda-empleo-ia",
  "version": "1.0.1",
  "description": "Buscador de empleo multiusuario con perfil por CV, match de skills y propuesta de interes. Argentina.",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rspack build --config rspack.config.js",
    "dev": "rspack dev --config rspack.config.js",
    "check": "node scripts/check.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint frontend/src --ext .js,.jsx"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/plugin-node-polyfill": "^0.5.8",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "style-loader": "^4.0.0"
  }
}

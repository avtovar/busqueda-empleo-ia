# ============================================================================
# Copiá este archivo como `.env` para desarrollo local, o configurá estas mismas
# variables en el panel de Vercel (Settings > Environment Variables).
# `.env` está en .gitignore: nunca se commitea, nunca se comparte por chat.
# ============================================================================

# ── Base de datos (Neon) ──────────────────────────────────────────────────────
# Es la URL con pooler de Neon, NO la directa: las funciones serverless abren y
# cierran conexiones por invocación, y la directa se queda sin conexiones.
# Neon > Connection Details > Pooled connection.
# En Supabase sería la transaction pooler (puerto 6543) por el mismo motivo.
# Si apuntás a un Postgres LOCAL que no habla TLS, agregale `?sslmode=disable`:
# sin eso la conexión falla con "The server does not support SSL connections",
# porque pg NO degrada a texto plano solo.
DATABASE_URL=

# Opcionales. Tienen defaults sentidos en api/lib/db.js: no hace falta tocarlas
# salvo que sepas lo que estás haciendo.
# Conexiones máximas POR invocación. Default 2. Subirlo multiplica por cada
# invocación en paralelo, contra el límite de la base: subilo solo si alguna
# función hace muchas queries a la vez.
PG_POOL_MAX=2
# Milisegundos que un cliente puede quedar ocioso antes de cerrarse. Default
# 10000. Alto para que una función corta devuelva el slot rápido; 0 desactiva.
PG_POOL_IDLE_MS=10000
# Solo para `npm run migrate`: cuánto esperar, en ms, si otra migración está
# corriendo. Default 60000.
MIGRATE_LOCK_TIMEOUT_MS=60000

# ── Sesiones ─────────────────────────────────────────────────────────────────
# Clave para firmar la cookie de sesión. Sin ella, no hay login.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OJO: rotarla invalida TODAS las sesiones abiertas. Con usuarios reales avisá.
SESSION_SECRET=

# ── Onboarding de CV (extracción con LLM) ───────────────────────────────────
# Clave del proveedor de LLM que parsea el CV y arma el perfil.
# Opcional: LLM_MODEL si el proveedor tiene más de un modelo.
LLM_API_KEY=
LLM_MODEL=

# ── Apify (búsqueda de LinkedIn) ─────────────────────────────────────────────
# Token del DUEÑO de la app, NO del usuario. Va solo en el servidor: el
# navegador llama a /api/linkedin-search y la función serverless agrega esto.
# Nunca lo mandes desde el cliente, nunca lo commitees, nunca lo imprimas.
# OJO GRAVE: cada búsqueda EJECUTA un actor y SE COBRA. No lo llames para probar
# que anda. Verificá el resto de los endpoints: son gratis.
APIFY_API_TOKEN=

# Máximo de ofertas por búsqueda de LinkedIn. Opcional, default 200.
# Subirlo cuesta plata de verdad.
APIFY_MAX_RESULTS=200

# Búsquedas de LinkedIn por usuario por día. Opcional, default 3.
APIFY_DAILY_LIMIT=3
